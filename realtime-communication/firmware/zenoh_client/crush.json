  "options": {
    "disable_default_providers": true,
    "disable_provider_auto_update": true,
    "disable_metrics": true,
    "disable_auto_summarize": true,
    "disabled_tools": [
      "agentic_fetch",
      "agent",
      "sourcegraph"
    ],
    "global_context_paths": [],
    "data_directory": ".crush",
    "auto_lsp": false
