	(text "Program Fast-Charge Safety Timer (TMR):\nRTMR = tMAXCHG / (10 × KTMR )\nKTMR = 48 s/kΩ from the electrical characteristics table.\nRTMR = (6.25 hr × 3600 s/hr) / (10 × 48 s/kΩ) = 46.8 kΩ ->  46.4 kΩ\n"
		(exclude_from_sim no)
		(at 34.798 160.782 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea738fe5-2335-4793-9193-f5993c10656a")
	)
	(text "Program the Input Current Limit (ILIM)\nRILIM = KILIM / II_MAX\nKILIM = 1550 AΩ from the electrical characteristics table.\nRISET = 1550 AΩ / 1.3 A = 1.192 kΩ -> 1.18 kΩ"
		(exclude_from_sim no)
		(at 34.798 170.688 0)
