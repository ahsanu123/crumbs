(version 1)
(rule "clearance for u2 only nrf52840 aqfn"
  (constraint clearance (min 0.01mm))
  (condition "A.Reference == 'U2'"))
(rule "Track to Pad Clearance"
    (constraint clearance (min 0.02mm))
    (condition "(A.Type == 'Track' && B.Type == 'Pad') || (A.Type == 'Pad' && B.Type == 'Track')"))
